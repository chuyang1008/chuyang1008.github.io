---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title, description = '初阳的公开学习档案，记录计算机科学、开发实践与日常思考。' } = Astro.props;
const pageTitle = title ? `${title} · 初阳` : '初阳 · 学习与思考';
const links = [['/', '首页'], ['/notes/', '文章'], ['/about/', '关于'], ['/contact/', '联系']];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="stylesheet" href="/fonts/title/hero.css" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳至正文</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="初阳，返回首页"><img class="brand-mark" src="/avatar.png" alt="" width="42" height="42" /><span>初阳</span></a>
        <nav aria-label="站点导航">{links.map(([href, label]) => <a href={href} aria-current={(href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href)) ? 'page' : undefined}>{label}</a>)}</nav>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer"><span>© {new Date().getFullYear()} 初阳</span><a href="https://github.com/chuyang1008" target="_blank" rel="noopener">GitHub ↗</a></footer>
    </div>
  </body>
</html>
