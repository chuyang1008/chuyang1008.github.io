---
import type { CollectionEntry } from 'astro:content';
import { getPostUrl } from '../lib/posts';
interface Props { posts: CollectionEntry<'blog'>[]; }
const { posts } = Astro.props;
---
<div class="note-list">
  {posts.map((post) => <a class="note-row" href={getPostUrl(post)}>
    <div class="note-meta"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}</time><span>{post.data.categories.join(' / ')}</span></div>
    <div class="note-body"><h2>{post.data.title}</h2><p>{post.data.description}</p></div>
    <span class="row-arrow" aria-hidden="true">↗</span>
  </a>)}
</div>
