---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteList from '../components/NoteList.astro';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout>
  <section class="home-grid">
    <div class="hero-terminal">
      <p class="command"><span>~</span> whoami</p>
      <h1>把学习，写成<br /><em>可复用的经验。</em></h1>
      <p class="lede">这里是楚阳的公开学习档案，记录 Web 开发实践、技术思考与真实踩坑。</p>
      <div class="command-links"><a href="/notes/">ls ./notes <b>→</b></a><a href="/about/">cat about.md <b>→</b></a></div>
    </div>
    <aside class="now-panel"><p class="panel-label">NOW / 现在</p><ul><li><span>→</span>前端工程化</li><li><span>→</span>React 与 Node.js</li><li><span>→</span>持续公开学习</li></ul></aside>
  </section>
  <section class="section-block">
    <div class="section-title"><p>RECENT_LOGS</p><h2>最近笔记</h2><a href="/notes/">查看全部 →</a></div>
    <NoteList posts={posts.slice(0, 5)} />
  </section>
</BaseLayout>
