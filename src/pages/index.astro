---
import { getPosts } from '../lib/posts';
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteList from '../components/NoteList.astro';
const posts = await getPosts();
---
<BaseLayout>
  <section class="home-intro">
    <h1>初阳</h1>
    <div class="intro-bottom"><a class="text-link" href="/about/">关于我 <span aria-hidden="true">↗</span></a></div>
  </section>
  <section class="section-block" aria-labelledby="latest-title">
    <div class="section-title"><h2 id="latest-title">最近文章</h2><a class="text-link" href="/notes/">全部文章 <span aria-hidden="true">→</span></a></div>
    <NoteList posts={posts.slice(0, 5)} />
  </section>
</BaseLayout>
