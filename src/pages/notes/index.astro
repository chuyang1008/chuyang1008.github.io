---
import { getPosts } from '../../lib/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteList from '../../components/NoteList.astro';
const posts = await getPosts();
---
<BaseLayout title="文章">
  <header class="page-intro"><h1>文章与笔记</h1></header>
  <div class="archive-heading"><h2>全部文章</h2><span>共 {posts.length} 篇</span></div>
  <NoteList posts={posts} />
</BaseLayout>
